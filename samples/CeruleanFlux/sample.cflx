use system

fault DivBy0
ptm div(fixed a: Float64, fixed b: Float64) reports DivBy0: Float64 {
  verify b != 0.0 else report DivBy0
  return a / b
}

ptm main() {
  attempt {
    fixed result = div(8, 0) 
  } handle DivBy0 {
    system#stdout#writen("Cannot divide by 0")
  } else {
    system#stdout#writen("Result: ${i?result}")
  }
}
