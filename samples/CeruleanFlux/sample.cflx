use system

enum MathError {
  DivBy0
}

ptm div(fixed a: Float64, fixed b: Float64): (Float64, Error?) {
  verify b != 0.0 else return 0.0, Error{ message: "Divide by 0", code: MathError#DivBy0 }
  return a / b, nothing
}

ptm main() {
  fixed result = attempt div(8, 0) handle MathError#DivBy0 {
      system#stdout#writen("Cannot divide by 0")
    } else {
      system#stdout#writen("Result: ${i?result}")
    }
}
